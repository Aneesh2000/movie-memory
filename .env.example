# --- Database (Neon Postgres) -----------------------------------------------
# `neon deploy` / `neon env pull` writes both of these for you.
# Pooled (-pooler host) URL used by the app:
DATABASE_URL=""
# Direct URL used by Prisma Migrate:
DATABASE_URL_UNPOOLED=""
# Local Docker alternative: set both to
# postgresql://postgres:postgres@localhost:5432/movie_memory

# --- Auth.js ----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only needed when self-hosting behind a proxy (not on Vercel):
# AUTH_TRUST_HOST=true

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=""
# Optional, defaults to gpt-4o-mini
# OPENAI_MODEL="gpt-4o-mini"
