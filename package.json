    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
